{
  "name": "city-dash-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CITY DASH 3D - an original 3D endless runner for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "framer-motion": "^14.14.0",
    "howler": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
